{
  "name": "wechat-article-agent - 01 generate draft",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-generate",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WECHAT_AGENT_API_BASE_URL || 'http://127.0.0.1:8088') + '/generate-draft' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.WECHAT_AGENT_API_TOKEN ? 'Bearer ' + $env.WECHAT_AGENT_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_mode: $env.WECHAT_AGENT_SOURCE_MODE || 'real' }) }}"
      },
      "id": "http-generate",
      "name": "Generate Draft API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "if-generate-result",
      "name": "Generate OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { workflow: 'generate-draft', status: $json.status, stage: $json.stage, record_id: $json.record_id, review_status: $json.review_status } }}"
      },
      "id": "set-generate-success",
      "name": "Generate Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        220
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { workflow: 'generate-draft', status: $json.status || 'failed', error: $json.error || 'Unknown error' } }}"
      },
      "id": "set-generate-failure",
      "name": "Generate Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        380
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Generate Draft API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Draft API": {
      "main": [
        [
          {
            "node": "Generate OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate OK?": {
      "main": [
        [
          {
            "node": "Generate Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generate Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Shanghai"
  },
  "pinData": {},
  "active": false
}
