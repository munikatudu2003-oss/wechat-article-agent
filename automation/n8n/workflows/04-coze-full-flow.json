{
  "name": "wechat-article-agent - 04 coze full flow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-full-flow",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WECHAT_AGENT_API_BASE_URL || 'http://127.0.0.1:8088') + '/pick-record' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.WECHAT_AGENT_API_TOKEN ? 'Bearer ' + $env.WECHAT_AGENT_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_mode: $env.WECHAT_AGENT_SOURCE_MODE || 'real', kind: 'pending' }) }}"
      },
      "id": "http-pick-record",
      "name": "Pick Pending Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.stage }}",
              "operation": "equal",
              "value2": "record_selected"
            }
          ]
        }
      },
      "id": "if-record-selected",
      "name": "Record Selected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COZE_WORKFLOW_URL || 'https://example.com/coze-workflow-webhook' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.COZE_API_TOKEN ? 'Bearer ' + $env.COZE_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ record_id: $json.record.record_id, title: $json.record.title, summary: $json.record.summary, category: $json.record.column_type, keywords: $json.record.keywords, target_words: $json.record.target_words, reference_material: $json.record.source_material, source_url: $json.record.source_url }) }}"
      },
      "id": "http-coze-generate",
      "name": "Coze Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        220
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WECHAT_AGENT_API_BASE_URL || 'http://127.0.0.1:8088') + '/ingest-draft' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.WECHAT_AGENT_API_TOKEN ? 'Bearer ' + $env.WECHAT_AGENT_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ record_id: $('Pick Pending Record').item.json.record.record_id, source_mode: $env.WECHAT_AGENT_SOURCE_MODE || 'real', title: $json.title, summary: $json.summary, markdown: $json.markdown, review_status: $json.review_status || 'approved', review_notes: $json.review_notes || ['Generated by Coze'], cover_prompt: $json.cover_prompt || '' }) }}"
      },
      "id": "http-ingest-draft",
      "name": "Ingest Draft API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WECHAT_AGENT_API_BASE_URL || 'http://127.0.0.1:8088') + '/create-draft' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.WECHAT_AGENT_API_TOKEN ? 'Bearer ' + $env.WECHAT_AGENT_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ record_id: $('Pick Pending Record').item.json.record.record_id, source_mode: $env.WECHAT_AGENT_SOURCE_MODE || 'real' }) }}"
      },
      "id": "http-create-draft",
      "name": "Create Draft API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "if-draft-created",
      "name": "Draft Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WECHAT_AGENT_API_BASE_URL || 'http://127.0.0.1:8088') + '/submit-publish' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.WECHAT_AGENT_API_TOKEN ? 'Bearer ' + $env.WECHAT_AGENT_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ record_id: $('Pick Pending Record').item.json.record.record_id, source_mode: $env.WECHAT_AGENT_SOURCE_MODE || 'real' }) }}"
      },
      "id": "http-submit-publish",
      "name": "Submit Publish API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        140
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WECHAT_AGENT_API_BASE_URL || 'http://127.0.0.1:8088') + '/sync-status' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.WECHAT_AGENT_API_TOKEN ? 'Bearer ' + $env.WECHAT_AGENT_API_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ record_id: $('Pick Pending Record').item.json.record.record_id, source_mode: $env.WECHAT_AGENT_SOURCE_MODE || 'real' }) }}"
      },
      "id": "http-sync-status",
      "name": "Sync Status API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2480,
        140
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { workflow: 'coze-full-flow', status: 'ok', record_id: $('Pick Pending Record').item.json.record.record_id, draft_stage: $('Create Draft API').item.json.stage, submit_stage: $('Submit Publish API').item.json.stage, sync_stage: $json.stage, publish_status: $json.publish_status || '', publish_url: $json.publish_url || '' } }}"
      },
      "id": "set-flow-success",
      "name": "Flow Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2760,
        140
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { workflow: 'coze-full-flow', status: 'skipped', stage: 'none_available' } }}"
      },
      "id": "set-no-record",
      "name": "No Record",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1080,
        420
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { workflow: 'coze-full-flow', status: 'failed', stage: $json.stage || 'failed', error: $json.error || 'Workflow failed' } }}"
      },
      "id": "set-flow-failure",
      "name": "Flow Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2200,
        320
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Pick Pending Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick Pending Record": {
